{
  "name": "comment-automations",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:db": "TEST_DATABASE_URL=postgres://automations:automations@localhost:54329/automations vitest run",
    "e2e": "node --disable-warning=ExperimentalWarning apps/e2e/src/main.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
